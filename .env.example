# Para emitir notas reais: NFSE_AMBIENTE=1 e NFSE_ALLOW_PRODUCTION=true
# NFSE_ALLOW_PRODUCTION=false
# Cadeia de certificados ICP-Brasil (.pem), se a validação TLS da SEFIN falhar.
# NFSE_CA_FILE=
